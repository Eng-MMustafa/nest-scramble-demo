{
  "name": "Users flow",
  "baseUrl": "http://localhost:3000",
  "steps": [
    {
      "name": "Create a new user.",
      "request": {
        "method": "POST",
        "path": "/api/users",
        "body": {
          "name": "John Doe",
          "email": "user@example.com",
          "age": 25
        }
      },
      "expect": {
        "status": 201,
        "matchesSpec": true
      },
      "capture": {
        "usersId": "$.id"
      }
    },
    {
      "name": "List all users, optionally filtered by name.",
      "request": {
        "method": "GET",
        "path": "/api/users"
      },
      "expect": {
        "status": 200,
        "matchesSpec": true
      }
    },
    {
      "name": "Get a single user by ID.",
      "request": {
        "method": "GET",
        "path": "/api/users/{{usersId}}"
      },
      "expect": {
        "status": 200,
        "matchesSpec": true
      }
    },
    {
      "name": "Update an existing user.",
      "request": {
        "method": "PUT",
        "path": "/api/users/{{usersId}}",
        "body": {
          "name": "John Doe",
          "email": "user@example.com"
        }
      },
      "expect": {
        "status": 200,
        "matchesSpec": true
      }
    },
    {
      "name": "Delete a user.",
      "request": {
        "method": "DELETE",
        "path": "/api/users/{{usersId}}"
      },
      "expect": {
        "status": 200,
        "matchesSpec": true
      }
    }
  ]
}
